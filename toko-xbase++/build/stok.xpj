[PROJECT]
   DEBUG                 = no
   TARGET_DIR            = ..\..\toko-64-bit
   stok.xpj

[stok.xpj]
   stok.exe

[stok.exe]
   COMPILE               = xpp
   COMPILE_FLAGS         = /q
   GUI                   = no
   LINKER                = alink
   LINK_FLAGS            =
   RC_COMPILE            = arc
   RC_FLAGS              =
   INTERMEDIATE_DEBUG    = .debug\stok
   INTERMEDIATE_RELEASE  = .release\stok
   MAIN_STOK.PRG
   STOK.PRG
   DAFKODE.PRG
   PASWOD.PRG
