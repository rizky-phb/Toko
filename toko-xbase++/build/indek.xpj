[PROJECT]
   DEBUG                 = no
   TARGET_DIR            = ..\..\toko-64-bit
   indek.xpj

[indek.xpj]
   indek.exe

[indek.exe]
   COMPILE               = xpp
   COMPILE_FLAGS         = /q
   GUI                   = no
   LINKER                = alink
   LINK_FLAGS            =
   RC_COMPILE            = arc
   RC_FLAGS              =
   INTERMEDIATE_DEBUG    = .debug\indek
   INTERMEDIATE_RELEASE  = .release\indek
   MAIN_INDEK.PRG
   INDEK.PRG
   IDENTS.PRG

